# Para activar IA y funciones de Supabase en el navegador (no subir secretos reales)
VITE_SUPABASE_URL=https://tu-proyecto.supabase.co
# Preferida para proyectos nuevos. También se admite VITE_SUPABASE_ANON_KEY
# durante la transición desde las claves JWT heredadas.
VITE_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxx
VITE_DATA_MODE=supabase
